{
  "name": "shakerdeck",
  "version": "1.0.0",
  "private": true,
  "description": "Mud check, hydraulics and material balance desk for a drilling fluids service",
  "keywords": [
    "drilling-fluids",
    "mud-engineering",
    "rheology",
    "hydraulics",
    "solids-control",
    "oilfield"
  ],
  "license": "MIT",
  "author": "glinskevxer <roym78109@gmail.com>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "smoke": "bash scripts/smoke.sh",
    "audit": "bash scripts/audit-check.sh",
    "check": "npm run lint && npm run format:check && npm test && npm run smoke && npm run release:check",
    "release:check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "bin": {
    "shakerdeck": "bin/shakerdeck.js"
  },
  "files": [
    "bin",
    "src"
  ]
}
